<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for the estate-landing LaunchAgent (ADR-0019 increment 5b). Install with
     scripts/install-estate-landing-launchd.sh, which substitutes __REPO_ROOT__ and __HOME__
     and writes ~/Library/LaunchAgents/com.devon.estate-landing.plist.

     No secrets live here: the wrapper fetches the read-scoped change-manager bearer and the
     orchestrator's system bearer from BWS at runtime.

     HOURLY, AT :15 (Landing Part 3b). Every pass reads the watch of this lane's landings and steps
     a bad one on -- production pointed back at the build before the bump, the revert opened and
     landed, the moving tag put back -- so a broken production waits an hour, not a day. Ordinary
     bumps are still landed only between 02:00 and 06:00 New York: the program asks about them
     only in those passes (`estate_lander.cli.LANDING_HOURS`), and the orchestrator refuses
     outside its window regardless. The dead-man check `sds-estate-landing` must expect an hourly
     ping.

     THE PASS IS BOUNDED BY THE ORCHESTRATOR, not by this schedule. One landing per repository per
     window is an admission term, so four firings in the hours do not mean four landings — the
     later ones report the earlier one's row and hold.

     RunAtLoad is false; the next hour catches up.

     The exit code is the report. launchd discards it, so read the log — 0 clean, 1 the tool
     failed, 3 a pull request is held on a condition somebody has to act on. A first pass that
     lands nothing while naming why is the conditions working. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.devon.estate-landing</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/scripts/run-estate-landing.sh</string>
        <!-- The wrapper does NOT force this. A bare run reports and asks for nothing, so the one
             invocation that can cause a landing is the scheduled one, and it says so here. -->
        <string>--submit</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict><key>Minute</key><integer>15</integer></dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/estate-landing.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/estate-landing.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
