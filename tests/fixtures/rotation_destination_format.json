{
  "format": "rotation-destination/1",
  "identity_fields": {
    "provider": [
      "name"
    ],
    "bws-secret": [
      "uuid"
    ],
    "coolify-env": [
      "instance",
      "resource_type",
      "uuid",
      "key",
      "redeploy"
    ],
    "coolify-env-hash": [
      "instance",
      "resource_type",
      "uuid",
      "key",
      "entry"
    ],
    "gh-actions-secret": [
      "repo",
      "name"
    ],
    "keychain": [
      "service",
      "account"
    ],
    "runtime-fetch": [
      "repo",
      "ref"
    ],
    "shell-export": [
      "file",
      "var"
    ]
  },
