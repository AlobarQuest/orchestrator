#!/usr/bin/env python3
"""Rotate a Postgres role's password on this host. Runs as root behind an SSH forced command.

One JSON line on stdin, one JSON line on stdout:

    {"verb": "set" | "probe" | "loaded", "target": "<name>", "password": "<64 hex>"?}

`set` answers {"changed": bool}, `probe` {"status": 200 | 401 | null}, `loaded`
{"fingerprints": {container: "<sha256 first 16>:<length>"}}. A refusal answers {"refused": reason}
and exits 2. Targets come from the root-owned TARGETS_PATH, never from the request. No verb returns
a password, logs one, or puts one in argv. Stdlib only.
"""

from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
import tomllib
from typing import Any

TARGETS_PATH = "/etc/sds-pg-rotate/targets.toml"
PASSWORD = re.compile(r"[0-9a-f]{64}")
IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_.-]*")
ENV_NAME = re.compile(r"[A-Z_][A-Z0-9_]*")
FINGERPRINT_PREFIX = 16
TIMEOUT = 60

# Postgres trusts loopback and the socket, so only a non-loopback address exercises the password.
PROBE_SCRIPT = (
    "IFS= read -r PGPASSWORD; export PGPASSWORD; "
    'exec psql -h "$(hostname -i | cut -d" " -f1)" -U "$1" -d "$2" -tAc "select 1"'
)


class Refused(Exception):
    pass


def _docker(args: list[str], stdin: str = "") -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(  # noqa: S603
            ["docker", *args],  # noqa: S607
            input=stdin,
            capture_output=True,
            text=True,
            timeout=TIMEOUT,
            check=False,
        )
    except OSError, subprocess.SubprocessError:
        raise Refused("docker_unavailable") from None


def _target(name: object) -> dict[str, Any]:
    try:
        with open(TARGETS_PATH, "rb") as handle:
            targets = tomllib.load(handle).get("target", {})
    except OSError, tomllib.TOMLDecodeError:
        raise Refused("targets_unreadable") from None
    target = targets.get(name) if isinstance(name, str) else None
    if not isinstance(target, dict):
        raise Refused("unknown_target")
    for key in ("container", "role", "database"):
        if not isinstance(target.get(key), str) or not IDENT.fullmatch(target[key]):
            raise Refused("bad_target")
    return target


def _probe(target: dict[str, Any], password: str) -> int | None:
    done = _docker(
        [
            "exec",
            "-i",
            target["container"],
            "sh",
            "-c",
            PROBE_SCRIPT,
            "sh",
            target["role"],
            target["database"],
        ],
        stdin=password + "\n",
    )
    if done.returncode == 0:
        return 200
    if "password authentication failed" in done.stderr:
        return 401
    return None


def _set(target: dict[str, Any], password: str) -> dict[str, Any]:
    if _probe(target, password) == 200:
        return {"changed": False}
    sql = f"ALTER ROLE \"{target['role']}\" WITH PASSWORD '{password}';\n"
    done = _docker(
        [
            "exec",
            "-i",
            target["container"],
            "psql",
            "-U",
            target["role"],
            "-d",
            target["database"],
            "-q",
            "-v",
            "ON_ERROR_STOP=1",
        ],
        stdin=sql,
    )
    if done.returncode != 0:
        raise Refused("alter_failed")
    return {"changed": True}


def _loaded(target: dict[str, Any]) -> dict[str, Any]:
    prints: dict[str, str] = {}
    for consumer in target.get("consumer", []):
        container, env = consumer.get("container"), consumer.get("env")
        if not (isinstance(container, str) and IDENT.fullmatch(container)):
            raise Refused("bad_target")
        if not (isinstance(env, str) and ENV_NAME.fullmatch(env)):
            raise Refused("bad_target")
        done = _docker(["exec", container, "sh", "-c", f'printf %s "${env}"'])
        value = done.stdout if done.returncode == 0 else ""
        digest = hashlib.sha256(value.encode()).hexdigest()[:FINGERPRINT_PREFIX]
        prints[container] = f"{digest}:{len(value)}" if value else ""
    return {"fingerprints": prints}


def run(line: str) -> tuple[dict[str, Any], int]:
    try:
        try:
            request = json.loads(line)
        except ValueError:
            raise Refused("bad_request") from None
        if not isinstance(request, dict):
            raise Refused("bad_request")
        verb = request.get("verb")
        if verb not in ("set", "probe", "loaded"):
            raise Refused("unknown_verb")
        if verb != "loaded":
            password = request.get("password")
            if not isinstance(password, str) or not PASSWORD.fullmatch(password):
                raise Refused("bad_password")
        target = _target(request.get("target"))
        if verb == "loaded":
            return _loaded(target), 0
        if verb == "probe":
            return {"status": _probe(target, password)}, 0
        return _set(target, password), 0
    except Refused as refusal:
        return {"refused": str(refusal)}, 2


def main() -> int:
    answer, code = run(sys.stdin.readline())
    sys.stdout.write(json.dumps(answer) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
